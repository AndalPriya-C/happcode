# ---- Server ----
NODE_ENV=production
PORT=4000
# Number of reverse proxies in front of the API (Render/Railway/Fly = 1). Needed for correct rate limiting by IP.
TRUST_PROXY=1
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ---- Judge0 (sandboxed execution service; runs on its own host, never inside this server) ----
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# Self-hosted Judge0 usually uses:  JUDGE0_AUTH_HEADER=X-Auth-Token  and JUDGE0_AUTH_TOKEN=<your token>
# RapidAPI-hosted Judge0 uses the header below plus the host header in JUDGE0_EXTRA_HEADERS.
JUDGE0_AUTH_HEADER=X-RapidAPI-Key
JUDGE0_AUTH_TOKEN=replace-me
JUDGE0_EXTRA_HEADERS={"X-RapidAPI-Host":"judge0-ce.p.rapidapi.com"}
# Judge0 CE does not ship PyPy 3 by default. Set this to the id of a PyPy runtime you added to your
# Judge0 deployment. Leave unset and PyPy 3 stays disabled.
PYPY3_JUDGE0_LANGUAGE_ID=

# ---- Execution limits (hard server caps; client requests are clamped to these) ----
MAX_CPU_TIME_SEC=5
MAX_WALL_TIME_SEC=10
MAX_MEMORY_MB=256
MAX_SOURCE_BYTES=65536
MAX_STDIN_BYTES=65536
MAX_CONCURRENT_EXECUTIONS=20

# ---- Rate limiting and storage ----
RATE_LIMIT_SUBMIT_PER_MIN=20
RESULT_TTL_MINUTES=30
